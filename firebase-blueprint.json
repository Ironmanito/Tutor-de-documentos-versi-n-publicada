{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile in the application with activity tracking",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email"
        },
        "displayName": {
          "type": "string",
          "maxLength": 150
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500
        },
        "tier": {
          "type": "string",
          "enum": ["free", "pro"]
        },
        "authProvider": {
          "type": "string",
          "maxLength": 50
        },
        "createdAt": {
          "type": "string"
        },
        "lastSeenAt": {
          "type": "string"
        },
        "sessionCount": {
          "type": "number"
        },
        "studiesCount": {
          "type": "number"
        }
      },
      "required": ["email"]
    },
    "Study": {
      "title": "Study",
      "description": "Study notebook containing extracted materials, summaries, and exam sessions",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "studyText": {
          "type": "string",
          "maxLength": 500000
        },
        "activeFileNames": {
          "type": "array"
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        },
        "gcsUri": {
          "type": "string",
          "maxLength": 500
        }
      },
      "required": ["title", "userId"]
    },
    "Feedback": {
      "title": "Feedback",
      "description": "User feedback, critiques, and feature suggestions",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "userEmail": {
          "type": "string",
          "maxLength": 200
        },
        "userName": {
          "type": "string",
          "maxLength": 150
        },
        "rating": {
          "type": "number",
          "minimum": 1,
          "maximum": 5
        },
        "category": {
          "type": "string",
          "enum": ["critique", "bug", "voice_tutor", "exam", "suggestion", "general"]
        },
        "comment": {
          "type": "string",
          "maxLength": 5000
        },
        "status": {
          "type": "string",
          "enum": ["new", "reviewed", "replied"]
        },
        "createdAt": {
          "type": "string"
        },
        "device": {
          "type": "string",
          "maxLength": 300
        }
      },
      "required": ["rating", "comment", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents"
    },
    "/users/{userId}/studies/{studyId}": {
      "schema": "Study",
      "description": "User study notebooks and exam sessions"
    },
    "/feedback/{feedbackId}": {
      "schema": "Feedback",
      "description": "User feedback submissions"
    }
  }
}
