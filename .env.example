# Gemini API key for AI study features and live voice sessions
GEMINI_API_KEY=

# Google Cloud Storage Bucket for file uploads and persistent notebook data
# Example: mi-bucket-de-archivos
GCS_BUCKET_NAME=

# Optional: Path to Google Service Account Key (Not required in Google Cloud Run as it auto-detects credentials)
GOOGLE_APPLICATION_CREDENTIALS=

# Notificaciones automáticas por correo al Administrador (Feedback y Fin de Sesión)
ADMIN_EMAIL=martinvelozz01@gmail.com

# Opción A (Recomendada para Gmail): Contraseña de aplicación de 16 letras de Google
GMAIL_USER=martinvelozz01@gmail.com
GMAIL_APP_PASSWORD=

# Opción B (Alternativa Resend API):
RESEND_API_KEY=
RESEND_FROM=Tutor de Cuaderno <onboarding@resend.dev>


