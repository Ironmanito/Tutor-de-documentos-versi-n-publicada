rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId);
      allow update: if isOwner(userId) && isValidId(userId);
      allow delete: if isOwner(userId) && isValidId(userId);

      match /studies/{studyId} {
        allow get: if isOwner(userId) && isValidId(studyId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(studyId) && request.resource.data.userId == userId;
        allow update: if isOwner(userId) && isValidId(studyId) && request.resource.data.userId == userId;
        allow delete: if isOwner(userId) && isValidId(studyId);
      }
    }
  }
}
